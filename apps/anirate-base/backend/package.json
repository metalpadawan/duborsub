{
  "name": "anime-platform-api",
  "version": "1.0.0",
  "description": "Anime Rating Platform — NestJS Backend",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "import:anime:anilist": "node scripts/import-anilist.mjs",
    "import:anime:catalogue": "node scripts/import-catalogue.mjs",
    "export:anime:anilist": "node scripts/export-anilist-catalog.mjs",
    "export:anime:offline": "node scripts/export-offline-catalog.mjs",
    "fetch:anime:popularity": "node scripts/fetch-kitsu-popularity.mjs",
    "refresh:anime": "node scripts/export-offline-catalog.mjs --download && node scripts/fetch-kitsu-popularity.mjs && node scripts/import-catalogue.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "migrate:json": "node scripts/migrate-json-to-postgres.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.24",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^3.0.12",
    "@types/passport-local": "^1.0.37",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "jest": "^30.5.2",
    "prisma": "^5.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.0.0"
  }
}
