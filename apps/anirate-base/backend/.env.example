# ============================================================
# BACKEND - copy this file to backend/.env and fill in values
# ============================================================

# Database: PostgreSQL. `npm run db:up` from the repo root starts the local one in
# Docker and rewrites both URLs below in your .env with a generated password, so
# leave them as they are; deployments supply their own.
DATABASE_URL="postgresql://anirate@localhost:5432/anime_platform?schema=public"
# The backend tests wipe this database on every run, so it must be a separate one
# whose name contains "test". The Docker database creates it on first start.
DATABASE_URL_TEST="postgresql://anirate@localhost:5432/anime_platform_test?schema=public"

# JWT - generate with: openssl rand -hex 64
JWT_SECRET="CHANGE_ME_generate_a_long_random_secret"
JWT_ISSUER=anirate-api
JWT_AUDIENCE=anirate-web

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_HOURS=24
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
TRUST_PROXY=false

# Local password-reset shortcut: returns the reset token in the API response so the
# forgot-password page can show it. Never enable outside local development; the
# backend refuses to start with this on when NODE_ENV=production.
EXPOSE_RESET_TOKEN=true


# Production only: demo accounts are never seeded in production. Set these to
# create the first admin when the database has no accounts yet.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Email: confirmation links and password resets. Any SMTP provider works (Resend,
# Postmark, Brevo, Amazon SES); copy the host, port, username and API key it gives
# you. Left unset, development prints the emails to the backend log instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AniRate <no-reply@your-domain>"

# Shared with the frontend (INTERNAL_API_KEY in frontend/.env.local) so the website's
# own page renders are not rate-limited. "npm run db:up" generates it locally.
# INTERNAL_API_KEY=
