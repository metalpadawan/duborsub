# ============================================================
# FRONTEND - copy this file to frontend/.env.local
# ============================================================

# This is the only value the browser should receive.
# Use HTTPS for every non-local environment.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional, server-side only: the API address used when Next.js renders the catalog.
# Use it when the server reaches the backend on an internal address. Falls back to
# NEXT_PUBLIC_API_URL.
# API_URL=http://backend:4000/api/v1

# Server-side only: shared with the backend's INTERNAL_API_KEY so this site's own page
# renders are not rate-limited. "npm run db:up" generates it locally.
# INTERNAL_API_KEY=

# The public address of the site, for link previews, canonical links and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://your-domain

# Shown on the privacy and terms pages for questions; without it they point to the
# request form.
# NEXT_PUBLIC_CONTACT_EMAIL=
