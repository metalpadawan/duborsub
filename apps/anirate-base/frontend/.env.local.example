# ============================================================
# FRONTEND - copy this file to frontend/.env.local
# ============================================================

# This is the only value the browser should receive.
# Use HTTPS for every non-local environment.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional, server-side only: the API address used when Next.js renders the catalog.
# Use it when the server reaches the backend on an internal address. Falls back to
# NEXT_PUBLIC_API_URL.
# API_URL=http://backend:4000/api/v1
