# Production settings for docker-compose.prod.yml. Copy to .env.production (git-ignored)
# and fill in every value. Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Domains: the website and the API, both pointed at this server in DNS.
SITE_DOMAIN=
API_DOMAIN=

# Secrets: long random values, each different.
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=

# The first admin account, created only while the database has no accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email delivery (Resend, Postmark, Brevo, SES...): needed for sign-up confirmation
# and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: a Discord or Slack incoming-webhook URL that receives server-error alerts.
ALERT_WEBHOOK_URL=

# Optional: shown on the privacy and terms pages.
CONTACT_EMAIL=
